DATABASE_URL="mysql://user:password@localhost:3306/ecommerce"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me"
AUTH_SECRET="replace-me"          # firma el JWT de sesión

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="no-reply@example.com"

# PixelPay Hosted Payment (todas del lado del servidor, nunca NEXT_PUBLIC_)
PIXELPAY_ENDPOINT="https://pixelpay.dev"
PIXELPAY_KEY_ID=""
PIXELPAY_SECRET_KEY=""            # Secret Key real (firma HMAC). NO es el Key ID ni la Public key
PIXELPAY_PAYMENT_HASH_SECRET=""   # opcional; si vacío usa PIXELPAY_SECRET_KEY
PIXELPAY_ENVIRONMENT="sandbox"    # sandbox | production
PIXELPAY_ACCESS_TOKEN=""          # header x-gw-access-token (firewall Cloudflare de PixelPay)
APP_URL="https://tu-dominio.com"  # público HTTPS, sin / final; en local usa un túnel (ngrok/cloudflared)
